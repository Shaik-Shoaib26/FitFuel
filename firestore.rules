rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Matches users/{userId} and all of its subcollections (nutrition, goals, etc.) with specific validation rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (request.resource.data.dailyCalorieTarget == null || request.resource.data.dailyCalorieTarget > 0)
          && (request.resource.data.proteinTargetGrams == null || request.resource.data.proteinTargetGrams > 0)
          && (request.resource.data.carbsTargetGrams == null || request.resource.data.carbsTargetGrams > 0)
          && (request.resource.data.fatTargetGrams == null || request.resource.data.fatTargetGrams > 0);
        allow delete: if isOwner(userId);
      }

      match /nutrition/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.calories is number && request.resource.data.calories >= 0
          && request.resource.data.protein is number && request.resource.data.protein >= 0
          && request.resource.data.carbohydrates is number && request.resource.data.carbohydrates >= 0
          && request.resource.data.fats is number && request.resource.data.fats >= 0
          && (!('servingSize' in request.resource.data) || (request.resource.data.servingSize is number && request.resource.data.servingSize > 0))
          && (!('sugar' in request.resource.data) || request.resource.data.sugar == null || (request.resource.data.sugar is number && request.resource.data.sugar >= 0))
          && (!('fiber' in request.resource.data) || request.resource.data.fiber == null || (request.resource.data.fiber is number && request.resource.data.fiber >= 0))
          && (!('sodium' in request.resource.data) || request.resource.data.sodium == null || (request.resource.data.sodium is number && request.resource.data.sodium >= 0));
        allow delete: if isOwner(userId);
      }

      match /health/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /weightHistory/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (request.resource.data.weight == null || request.resource.data.weight > 0);
        allow delete: if isOwner(userId);
      }

      match /pantry/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (request.resource.data.quantity == null || request.resource.data.quantity >= 0);
        allow delete: if isOwner(userId);
      }

      match /groceryLists/{docId} {
        allow read, write: if isOwner(userId);

        match /items/{itemId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && (request.resource.data.quantity == null || request.resource.data.quantity >= 0);
          allow delete: if isOwner(userId);
        }
      }

      match /customFoods/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /favoriteFoods/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /recentFoods/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /groceryPreferences/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /mealPlans/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /reminderSettings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
